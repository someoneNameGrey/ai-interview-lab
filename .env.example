# Copy to .env in the directory where you run grey. Shell variables take precedence.
# codex = local Codex Python SDK; claude = local Claude Code; openai = Responses API.
GREY_LLM_PROVIDER=codex

# Verified with this project's local Codex CLI. For Claude, use e.g. sonnet or opus.
# Empty uses the local CLI's configured default. Any accessible model ID is accepted.
GREY_LLM_MODEL=gpt-5.5
# Empty uses GREY_LLM_MODEL (or the CLI default).
GREY_LLM_EVALUATOR_MODEL=

# Question/coaching effort. Empty inherits the provider's configured default.
# Supported levels depend on provider/model; medium is the starting setting.
GREY_LLM_EFFORT=medium
# Empty inherits the main effort; e.g. high for more thorough reviews.
GREY_LLM_EVALUATOR_EFFORT=

# Optional executable paths. Codex uses PATH first, then the SDK's bundled runtime.
# GREY_CODEX_BIN=C:/path/to/codex.exe
# GREY_CLAUDE_BIN=C:/path/to/claude.exe

# Required only for GREY_LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# Optional tutor/chat overrides. Empty inherits the main model and effort.
GREY_LLM_TUTOR_MODEL=
GREY_LLM_TUTOR_EFFORT=
